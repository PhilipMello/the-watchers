{
  "manifest_version": "1.0.0",
  "id": "watchers.github",
  "type": "plugin",
  "name": "GitHub",
  "description": "Review public changes and create a pull request from the workspace.",
  "version": "0.0.0",
  "core": ">=0.0.0 <0.1.0",
  "api": ">=1.0.0 <2.0.0",
  "entry": "index.mjs",
  "dependencies": {
    "watchers.objects": ">=0.0.0 <0.1.0",
    "watchers.settings": ">=0.0.0 <0.1.0"
  },
  "permissions": [
    "registry.write",
    "storage.local"
  ]
}
